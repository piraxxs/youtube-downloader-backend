{
  "manifest_version": 3,
  "name": "YouTube Downloader",
  "version": "1.0.0",
  "description": "Télécharge des vidéos YouTube en MP3 ou MP4 via une API locale.",
  "action": {
    "default_title": "YouTube Downloader",
    "default_popup": "popup.html"
  },
  "permissions": [
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
